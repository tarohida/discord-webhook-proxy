{
  "name": "tarohida/discord-webhook-proxy",
  "description": "backend application to send request to discord webhook api",
  "keywords": [
    "discord",
    "web application"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Taro Hida",
      "email": "sk8trou@gmail.com",
      "homepage": "https://github.com/tarohida/"
    }
  ],
  "require": {
    "php": "^8",
    "ext-json": "*",
    "guzzlehttp/guzzle": "*",
    "monolog/monolog": "*",
    "php-di/php-di": "*",
    "slim/psr7": "*",
    "slim/slim": "*"
  },
  "require-dev": {
    "jangregor/phpstan-prophecy": "*",
    "phpspec/prophecy-phpunit": "*",
    "phpstan/extension-installer": "*",
    "phpstan/phpstan": "*",
    "phpunit/phpunit": "*",
    "squizlabs/php_codesniffer": "*"
  },
  "config": {
    "process-timeout": 0,
    "sort-packages": true,
    "allow-plugins": {
      "phpstan/extension-installer": true
    }
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "start": "./dev-start.sh",
    "test": "phpunit"
  }
}
